# Пример окружения. Скопируйте в .env (docker compose читает его автоматически)
# или экспортируйте переменные вручную перед запуском backend'а.

# ── Фронтенд ────────────────────────────────────────────────────────────────
# URL backend'а консенсуса (по умолчанию http://127.0.0.1:8756).
# CONSENSUS_BACKEND_URL=http://127.0.0.1:8756

# ── VLM-режим авторазметки (backend/pipeline_vlm.py) ────────────────────────
# Базовые URL OpenAI-совместимых сервисов моделей. Модели поднимаются
# ОТДЕЛЬНО (llama-server / Ollama / vLLM) — backend только шлёт им HTTP.
# Поднять всё разом: scripts/vlm/setup.sh --cpu  (или scripts\vlm\setup.ps1 -Cpu)
# либо docker compose --profile vlm-cpu up -d  /  --profile vlm-gpu up -d
#
# CPU-движки:
#   glm-ocr             — ollama pull glm-ocr                     (:11434)
#   MedAIBase/PaddleOCR-VL:0.9b — ollama pull ...  (community-тег, :11434)
#   HunyuanOCR          — llama-server -hf ggml-org/HunyuanOCR-GGUF (:8081)
GLM_OCR_ENDPOINT=http://localhost:11434
PADDLEOCR_VL_ENDPOINT=http://localhost:11434
HUNYUAN_OCR_ENDPOINT=http://localhost:8081

# GPU-движки (нужна карта + nvidia-container-toolkit; профиль vlm-gpu):
#   dots.ocr            — vLLM >= 0.11.0                          (:8082)
#   baidu/Unlimited-OCR — vLLM / SGLang                            (:8083)
DOTS_OCR_ENDPOINT=http://localhost:8082
UNLIMITED_OCR_ENDPOINT=http://localhost:8083
