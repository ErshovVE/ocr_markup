# Backend: OCR Consensus (спайк) — GPU-сборка: torch с CUDA (PyPI) для Surya.
# Отличается от backend/Dockerfile только источником torch. PaddleOCR остаётся
# на CPU (пакет paddlepaddle, не paddlepaddle-gpu). Образ больше на несколько ГБ.
# Запуск: docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build
# (нужен nvidia-container-toolkit).
FROM python:3.12-slim

# tesseract-ocr-rus — системный языковой пакет, без него pytesseract lang="rus" падает.
# libgl1/libglib2.0-0 — рантайм-зависимости opencv-python на slim-образе.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-rus \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# uv, а не pip: нужен --override (перестраховочные пины surya-ocr, см. overrides.txt).
# torch — CUDA-сборка по умолчанию с PyPI (тянет пакеты nvidia-*).
COPY backend/requirements.txt backend/overrides.txt backend/
RUN pip install --no-cache-dir "uv>=0.5,<1" \
    && uv pip install --system --no-cache -r backend/requirements.txt --override backend/overrides.txt

COPY backend/ backend/

EXPOSE 8756

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8756"]
